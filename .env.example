# Local Docker MongoDB (single-node replica set — required for transactions later).
# Working local URI after `make up`:
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# MongoDB database name used by the app
MONGODB_DB_NAME=agri_supply

# Base address for seed supplier contacts. The seed script uses plus-addressing
# (e.g. team+greenfield@example.com) so demo emails hit a team inbox, never a real business.
SEED_CONTACT_EMAIL_BASE=team@example.com

# Auth backend: "dev" for local mock auth, "cognito" for AWS Cognito
AUTH_MODE=dev

# AWS region for Bedrock, SES, Cognito, and other services (default us-west-2)
AWS_REGION=us-west-2

# AI backend: "mock" for canned responses, "bedrock" for Claude on Amazon Bedrock
AI_MODE=mock

# Bedrock model ID for Claude (used when AI_MODE=bedrock)
BEDROCK_MODEL_ID=

# Email backend: "log" prints to the console, "ses" sends via Amazon SES
EMAIL_MODE=log

# Verified SES sender address used for outbound supplier emails
SES_FROM_ADDRESS=

# Cognito User Pool ID that holds user accounts
COGNITO_USER_POOL_ID=

# Cognito App Client ID used by the web app to sign users in
COGNITO_CLIENT_ID=

# Cognito hosted UI / OAuth domain prefix (without https://)
COGNITO_DOMAIN=

# Public base URL of this app (e.g. http://localhost:3000)
APP_URL=http://localhost:3000

# --- Stretch goal: file uploads (S3) — not required for the core hackathon flow ---
# S3_UPLOAD_BUCKET=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=
