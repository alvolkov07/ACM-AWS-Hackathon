# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# AWS Bedrock
USE_BEDROCK=1
AWS_REGION=us-east-1
# Or use the Anthropic API instead: set USE_BEDROCK=0 and add your key.
ANTHROPIC_API_KEY=
# Choose haiku, sonnet, or opus. CLAUDE_MODEL overrides this when set
# (required with Bedrock, since its model IDs vary by region/account).
CLAUDE_TIER=haiku
CLAUDE_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# Optional per-task tiers; each overrides CLAUDE_TIER for its task.
# If both are blank and CLAUDE_TIER is blank too, fast uses haiku and smart uses sonnet.
# Fast: search phrasing, review summaries. Smart: email drafts, chat.
CLAUDE_FAST_TIER=
CLAUDE_SMART_TIER=

# SerpAPI key for supplier search (search returns 503 without it)
SERPAPI_KEY=
# Used for converting farm addresses to latitude/longitude and state.
GEOCODING_USER_AGENT=agri-supply-mvp/1.0

# Optional: real email sending (otherwise sending is simulated)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
